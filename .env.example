# Django
# SECRET KEY: MUST be replaced with a strong random value in production!
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: comma-separated CSRF trusted origins for reverse proxies / Portainer over HTTPS
# DJANGO_CSRF_TRUSTED_ORIGINS=https://darts.example.com
# Behind a TLS-terminating reverse proxy (Synology DSM, nginx, …): trust the
# proxy's X-Forwarded-Proto header so Django sees the original https:// scheme.
# DJANGO_SECURE_PROXY_SSL_HEADER=True

# Security hardening (Phase 9) — enable when served behind HTTPS
# (sets SECURE_SSL_REDIRECT + secure session/CSRF cookies)
DJANGO_SECURE_SSL_REDIRECT=False
# HSTS max-age in seconds; 0 disables (e.g. 31536000 = 1 year once HTTPS is stable)
DJANGO_SECURE_HSTS_SECONDS=0
# Force secure cookies independently of the SSL redirect (1/true = secure).
# Defaults to the value of DJANGO_SECURE_SSL_REDIRECT when left unset.
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True

# Notifications: send system e-mails in a background thread (1 = async) so
# SMTP latency never blocks the single web worker. Default: True.
# NOTIFICATIONS_ASYNC=True
# Log level for the project's own loggers (app.*), default INFO.
# DJANGO_LOG_LEVEL=INFO

# Language / timezone
DJANGO_LANGUAGE_CODE=de
DJANGO_TIME_ZONE=Europe/Berlin

# SQLite path (relative paths resolve against the project root / /app in Docker)
SQLITE_PATH=data/db.sqlite3

# Bootstrap admin (idempotent). Leave PASSWORD empty to disable.
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# Compose host port for the PRODUCTION stack (docker-compose.yml maps
# "${BIND_PORT:-8000}:8000"; the container itself always listens on 8000).
# The private livesystem test (tests/private_livesystem_test/) defines its
# host port directly in its own docker-compose.yml instead.
BIND_PORT=8000

# SMTP (central e-mail delivery — registration, approval, penalties, repayments)
# No credentials in the repository: fill these in on the server only.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Sender addresses
DEFAULT_FROM_EMAIL=
SUPPORT_EMAIL=

# Public base URL of the installation — used for absolute links in e-mails
# (e.g. the activation link). Example: https://darts.example.com
PUBLIC_SITE_URL=

# E-mail verification after signup: mandatory | optional | none
# ("mandatory" = the address must be confirmed via link before the first login)
ACCOUNT_EMAIL_VERIFICATION=mandatory

# Spam protection for self-registration (see README, "User approval"):
# signup rate limit per IP (django-allauth syntax, default "10/m/ip,50/h/ip")
SIGNUP_RATE_LIMIT=
# Number of trusted reverse proxies in front of the app (0 = none/direct).
# Needed so the rate limiter sees the REAL client IP behind nginx/Traefik.
ALLAUTH_TRUSTED_PROXY_COUNT=0

# Legal / Impressum + Privacy Policy (rendered on /imprint/ and /privacy/)
CONTACT_COMPANY=Dart Club Example e.V.
CONTACT_NAME=Max Mustermann
CONTACT_STREET=Musterstrasse 1
CONTACT_CITY=11111 Musterstadt
CONTACT_EMAIL=max.Mustermann@example.com

# Optional legacy imprint (CONTACT_* above takes precedence for the company)
# IMPRINT_NAME=Dart Club Example e.V.
# IMPRINT_URL=https://example.com/imprint